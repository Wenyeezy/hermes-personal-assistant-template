# Example environment variables
# Copy to .env locally if needed, but never commit real .env files.

EXAMPLE_PROVIDER_API_KEY=replace_me

# Optional sanitized-runtime providers. Keep real values in an ignored .env,
# shell environment, or secret manager.
OPENAI_API_KEY=replace_me
HERMES_OPENAI_MODEL=replace_me
HERMES_OLLAMA_MODEL=replace_me
HERMES_COMPAT_BASE_URL=https://example.provider/v1
HERMES_COMPAT_MODEL=replace_me
HERMES_COMPAT_API_KEY=replace_me

# Optional authenticated Apple Health / TestFlight LAN bridge.
# Use a unique password and keep both values outside Git.
HERMES_HEALTH_USERNAME=hermes
HERMES_HEALTH_PASSWORD=replace_me

# Messaging/gateway examples. Replace with real values locally only.
WEIXIN_ACCOUNT_ID=replace_me
WEIXIN_TOKEN=replace_me

# Optional safety preference
GATEWAY_ALLOW_ALL_USERS=false
